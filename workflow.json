                                         },
                          "id":  "b3cd6d68-9461-4a00-8ec8-52162bc32749",
                          "name":  "Aggregate All Papers",
                          "type":  "n8n-nodes-base.aggregate",
                          "typeVersion":  1,
                          "position":  [
                                           1980,
                                           200
                                       ]
                      },
                      {
                          "parameters":  {
                                             "mode":  "runOnceForAllItems",
                                             "jsCode":  "const aggregate = $input.first()?.json || {};\nconst papers = Array.isArray(aggregate.papers)\n  ? aggregate.papers\n  : $input.all().map((item) =\u003e item.json);\n\nconst today = new Intl.DateTimeFormat(\u0027en-IN\u0027, {\n  timeZone: \u0027Asia/Kolkata\u0027,\n  weekday: \u0027long\u0027,\n  year: \u0027numeric\u0027,\n  month: \u0027short\u0027,\n  day: \u0027numeric\u0027,\n}).format(new Date());\n\nfunction escapeHtml(value) {\n  return String(value ?? \u0027\u0027)\n    .replace(/\u0026/g, \u0027\u0026amp;\u0027)\n    .replace(/\u003c/g, \u0027\u0026lt;\u0027)\n    .replace(/\u003e/g, \u0027\u0026gt;\u0027)\n    .replace(/\"/g, \u0027\u0026quot;\u0027)\n    .replace(/\u0027/g, \u0027\u0026#39;\u0027);\n}\n\nfunction formatSummary(summary) {\n  return escapeHtml(summary || \u0027Summary unavailable\u0027)\n    .replace(/^(Contribution|Method|Evidence|Limitations|Tags):/gim, \u0027\u003cb\u003e$1:\u003c/b\u003e\u0027);\n}\n\nconst matchedCategories = [...new Set(papers.map((paper) =\u003e paper.topic).filter(Boolean))];\nconst header = \u0027\u003cb\u003ePaperPulse | Daily Research Digest\u003c/b\u003e\\n\u0027 +\n  today + \u0027 | \u0027 + papers.length + (papers.length === 1 ? \u0027 new paper\u0027 : \u0027 new papers\u0027) + \u0027\\n\u0027 +\n  \u0027Filters matched: \u0027 + escapeHtml(matchedCategories.join(\u0027, \u0027) || \u0027none\u0027) + \u0027 | Source: arXiv\\n\\n\u0027;\nconst footer = \u0027\u003ci\u003eAI summaries use arXiv abstracts. Check the full paper before citing specific claims.\u003c/i\u003e\u0027;\nconst separator = \u0027--------------------------------\u0027;\n\nfunction paperBlock(paper, index) {\n  const categories = Array.isArray(paper.categories) \u0026\u0026 paper.categories.length\n    ? paper.categories.join(\u0027, \u0027)\n    : paper.primaryCategory || paper.topic || \u0027Not listed\u0027;\n  const paperUrl = paper.url || (\u0027https://arxiv.org/abs/\u0027 + encodeURIComponent(paper.arxivId || \u0027\u0027));\n  let block = \u0027\u003cb\u003e\u0027 + (index + 1) + \u0027. \u0027 + escapeHtml(paper.title) + \u0027\u003c/b\u003e\\n\u0027 +\n    \u0027\u003ccode\u003earXiv:\u0027 + escapeHtml(paper.arxivId) + \u0027\u003c/code\u003e | Submitted: \u0027 + escapeHtml(paper.published || \u0027Not listed\u0027) + \u0027\\n\u0027 +\n    \u0027Matched filter: \u003ccode\u003e\u0027 + escapeHtml(paper.topic || \u0027Not listed\u0027) + \u0027\u003c/code\u003e | Primary category: \u003ccode\u003e\u0027 + escapeHtml(paper.primaryCategory || \u0027Not listed\u0027) + \u0027\u003c/code\u003e\\n\u0027 +\n    \u0027Subjects: \u0027 + escapeHtml(categories) + \u0027\\n\u0027 +\n    \u0027Authors: \u0027 + escapeHtml(paper.authors || \u0027Not listed\u0027) + \u0027\\n\u0027;\n  if (paper.journalRef) block += \u0027Journal reference: \u0027 + escapeHtml(paper.journalRef) + \u0027\\n\u0027;\n  if (paper.doi) block += \u0027DOI: \u003ccode\u003e\u0027 + escapeHtml(paper.doi) + \u0027\u003c/code\u003e\\n\u0027;\n  block += \u0027\u003ca href=\"\u0027 + escapeHtml(paperUrl) + \u0027\"\u003eOpen paper on arXiv\u003c/a\u003e\\n\\n\u0027 +\n    \u0027\u003cb\u003eResearch brief\u003c/b\u003e\\n\u0027 + formatSummary(paper.summary) + \u0027\\n\\n\u0027 +\n    separator + \u0027\\n\\n\u0027;\n  return block;\n}\n\nconst messages = [];\nlet message = header;\nfor (let index = 0; index \u003c papers.length; index++) {\n  const block = paperBlock(papers[index], index);\n  if (message.length + block.length + footer.length \u003e 3500 \u0026\u0026 message !== header) {\n    messages.push(message + footer);\n    message = header;\n  }\n  message += block;\n}\nmessages.push(message + footer);\n\nreturn messages.map((text) =\u003e ({\n  json: { text },\n  pairedItem: { item: 0 },\n}));"
                                         },
