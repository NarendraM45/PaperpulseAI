                          "id":  "80ef4fa9-0746-4964-bc60-8e8734f28d1e",
                          "name":  "Fetch ArXiv Papers",
                          "type":  "n8n-nodes-base.httpRequest",
                          "typeVersion":  4.2,
                          "position":  [
                                           660,
                                           300
                                       ],
                          "retryOnFail":  true,
                          "maxTries":  3,
                          "waitBetweenTries":  2000
                      },
                      {
                          "parameters":  {
                                             "mode":  "runOnceForAllItems",
                                             "jsCode":  "const topicItems = $(\u0027Build ArXiv URLs\u0027).all();\n\nreturn $input.all().flatMap((httpItem, itemIndex) =\u003e {\n  const xmlText = String(httpItem.json.data || httpItem.json.body || \u0027\u0027);\n  const topic = topicItems[itemIndex]?.json.topic || \u0027\u0027;\n  const papers = [];\n\n  function decodeXml(value) {\n    return value\n      .replace(/\u0026#x([0-9a-f]+);/gi, (_, hex) =\u003e String.fromCodePoint(parseInt(hex, 16)))\n      .replace(/\u0026#([0-9]+);/g, (_, dec) =\u003e String.fromCodePoint(parseInt(dec, 10)))\n      .replace(/\u0026lt;/g, \u0027\u003c\u0027)\n      .replace(/\u0026gt;/g, \u0027\u003e\u0027)\n      .replace(/\u0026quot;/g, \u0027\"\u0027)\n      .replace(/\u0026apos;/g, \"\u0027\")\n      .replace(/\u0026amp;/g, \u0027\u0026\u0027);\n  }\n\n  function getTag(entry, tag) {\n    const match = entry.match(new RegExp(\u0027\u003c\u0027 + tag + \u0027\\\\b[^\u003e]*\u003e([\\\\s\\\\S]*?)\u003c\\\\/\u0027 + tag + \u0027\u003e\u0027));\n    return match ? decodeXml(match[1].replace(/\u003c[^\u003e]+\u003e/g, \u0027 \u0027).replace(/\\s+/g, \u0027 \u0027).trim()) : \u0027\u0027;\n  }\n\n  function getAttribute(entry, tag, attribute) {\n    const tagMatch = entry.match(new RegExp(\u0027\u003c\u0027 + tag + \u0027\\\\b([^\u003e]*)\u003e\u0027, \u0027i\u0027));\n    if (!tagMatch) return \u0027\u0027;\n    const attributeMatch = tagMatch[1].match(new RegExp(\u0027\\\\b\u0027 + attribute + \u0027=\"([^\"]*)\"\u0027, \u0027i\u0027));\n    return attributeMatch ? decodeXml(attributeMatch[1]) : \u0027\u0027;\n  }\n\n  const entryRegex = /\u003centry(?:\\s[^\u003e]*)?\u003e([\\s\\S]*?)\u003c\\/entry\u003e/g;\n  let match;\n  while ((match = entryRegex.exec(xmlText)) !== null) {\n    const entry = match[1];\n    const fullId = getTag(entry, \u0027id\u0027);\n    const arxivId = (fullId.split(\u0027/abs/\u0027)[1] || \u0027\u0027).replace(/v\\d+$/, \u0027\u0027);\n    if (!arxivId) continue;\n\n    const authorNames = [...entry.matchAll(/\u003cname\u003e([\\s\\S]*?)\u003c\\/name\u003e/g)]\n      .map((item) =\u003e decodeXml(item[1].trim()));\n    const authors = authorNames.slice(0, 3).join(\u0027, \u0027) +\n      (authorNames.length \u003e 3 ? \u0027 +\u0027 + (authorNames.length - 3) + \u0027 more\u0027 : \u0027\u0027);\n    const categories = [...entry.matchAll(/\u003ccategory\\b[^\u003e]*\\bterm=\"([^\"]+)\"[^\u003e]*\\/?\u003e/gi)]\n      .map((item) =\u003e decodeXml(item[1]));\n    const primaryCategory = getAttribute(entry, \u0027arxiv:primary_category\u0027, \u0027term\u0027) || categories[0] || topic;\n\n    papers.push({\n      json: {\n        arxivId,\n        title: getTag(entry, \u0027title\u0027),\n        abstract: getTag(entry, \u0027summary\u0027).slice(0, 5000),\n        authors,\n        published: getTag(entry, \u0027published\u0027).split(\u0027T\u0027)[0],\n        topic,\n        primaryCategory,\n        categories: [...new Set(categories)],\n        doi: getTag(entry, \u0027arxiv:doi\u0027),\n        journalRef: getTag(entry, \u0027arxiv:journal_ref\u0027),\n        url: \u0027https://arxiv.org/abs/\u0027 + arxivId,\n      },\n      pairedItem: { item: itemIndex },\n    });\n  }\n\n  return papers;\n});"
                                         },
                          "id":  "813bba52-6974-4ecb-b67b-f6429675ce81",
                          "name":  "Parse ArXiv XML",
                          "type":  "n8n-nodes-base.code",
                          "typeVersion":  2,
                          "position":  [
                                           880,
                                           300
                                       ]
                      },
                      {
                          "parameters":  {
                                             "mode":  "runOnceForAllItems",
                                             "jsCode":  "const store = $getWorkflowStaticData(\u0027global\u0027);\nconst seen = new Set(Array.isArray(store.seenIds) ? store.seenIds : []);\nconst newPapers = [];\n\nfor (const item of $input.all()) {\n  const id = item.json.arxivId;\n  if (id \u0026\u0026 !seen.has(id)) {\n    seen.add(id);\n    newPapers.push(item);\n  }\n}\n\nif (newPapers.length === 0) {\n  return [{ json: { empty: true, message: \u0027No new papers today!\u0027 } }];\n}\n\n// Static data is committed by n8n after a successful production execution.\nstore.seenIds = Array.from(seen).slice(-2000);\nreturn newPapers;"
                                         },
