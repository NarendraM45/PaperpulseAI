                      },
                      {
                          "parameters":  {
                                             "mode":  "runOnceForAllItems",
                                             "jsCode":  "const config = $(\u0027Config\u0027).first().json;\nconst topics = Array.isArray(config.topics) ? config.topics : [];\nconst maxResults = Math.max(1, Math.min(25, Number(config.max_results) || 5));\n\nreturn topics.map((topic) =\u003e ({\n  json: {\n    topic,\n    url: \u0027https://export.arxiv.org/api/query?search_query=cat:\u0027 +\n      encodeURIComponent(topic) +\n      \u0027\u0026sortBy=submittedDate\u0026sortOrder=descending\u0026max_results=\u0027 + maxResults,\n  },\n}));"
                                         },
                          "id":  "50783cac-2b63-4ad9-accb-5803105d744e",
